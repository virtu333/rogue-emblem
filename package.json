{
  "name": "emblem-rogue",
  "version": "0.1.0",
  "description": "A Fire Emblem x Roguelike Tactical RPG",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/buildReferenceContent.js && node tools/syncData.js && node tools/syncAssets.js && vite build",
    "preview": "vite preview",
    "build:reference": "node tools/buildReferenceContent.js",
    "check:reference": "node tools/buildReferenceContent.js --check",
    "check:data-parity": "node tools/checkDataParity.js",
    "check:threshold-pr-notes": "node tools/checkThresholdPrNotes.js",
    "check:content": "node tools/checkContentIntegrity.js",
    "sync-data": "node tools/syncData.js",
    "sync-assets": "node tools/syncAssets.js",
    "gen:icons": "node tools/gen-app-icons.js",
    "imagen:generate": "node tools/imagen-pipeline/generate.js",
    "imagen:generate:dry": "node tools/imagen-pipeline/generate.js --dry-run",
    "imagen:process": "node tools/imagen-pipeline/process.js",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude tests/harness/** --exclude tests/sim/** --exclude tests/agents/** --exclude tests/fixtures/** --exclude tests/artifacts/**",
    "test:watch": "vitest",
    "sim:progression": "node sim/progression.js",
    "sim:matchups": "node sim/matchups.js",
    "sim:economy": "node sim/economy.js",
    "sim:fullrun": "node sim/fullrun.js",
    "sim:colosseum": "node sim/colosseum.js",
    "test:harness": "vitest run tests/harness",
    "test:harness:watch": "vitest watch tests/harness",
    "test:harness:pr": "node tests/agents/fuzz-runner.js --seeds 10 --all-scenarios --mode strict --use-default-scenario-budgets",
    "test:sim": "vitest run tests/sim",
    "test:sim:triage": "vitest run tests/sim/fullrun-slice-triage.test.js tests/sim/fullrun-slice-triage.workflow.test.js",
    "sim:fullrun:harness": "node tests/sim/fullrun-runner.js --seeds 20 --difficulty normal --mode reporting --timeout-rate-threshold 8",
    "sim:fullrun:harness:invincible": "node tests/sim/fullrun-runner.js --seeds 20 --difficulty normal --invincibility --mode reporting --timeout-rate-threshold 8",
    "sim:fullrun:harness:pr": "node tests/sim/fullrun-slice-runner.js --suite pr",
    "sim:fullrun:pr": "node tests/sim/fullrun-slice-runner.js --suite pr",
    "sim:fullrun:harness:pr:single": "node tests/sim/fullrun-runner.js --seeds 10 --difficulty normal --mode strict",
    "sim:fullrun:harness:slices:list": "node tests/sim/fullrun-slice-runner.js --list",
    "sim:fullrun:harness:triage": "node tests/sim/fullrun-slice-triage.js",
    "sim:fullrun:triage": "node tests/sim/fullrun-slice-triage.js",
    "test:merge-gate:scene-lifecycle": "npm run test:unit && npm run test:harness && npm run sim:fullrun:pr && npm run test:e2e",
    "fuzz": "node tests/agents/fuzz-runner.js --seeds 100 --scenario act1_rout_basic",
    "fuzz:nightly": "node tests/agents/fuzz-runner.js --seeds 150 --all-scenarios --mode reporting --timeout-rate-threshold 5 --use-default-scenario-budgets",
    "fuzz:nightly:strict": "node tests/agents/fuzz-runner.js --seeds 150 --all-scenarios --mode strict --use-default-scenario-budgets",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test tests/e2e/boot.spec.js tests/e2e/scene-transitions.spec.js tests/e2e/accessory-ui.spec.js",
    "test:e2e:headed": "npx playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=-1 .",
    "lint:fix": "eslint --fix .",
    "validate:data": "node tools/validateSchemas.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ],
    "*.{json,html,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "phaser": "^3.80.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "ajv": "^8.18.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  }
}
