{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blessings",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "debtScale": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "tierBands": {
      "type": "object",
      "patternProperties": {
        "^\\d+$": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "offerWeights": {
      "type": "object",
      "patternProperties": {
        "^\\d+$": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "earnedOffer": {
      "type": "object",
      "properties": {
        "actBoss": {
          "type": "integer",
          "minimum": 1
        },
        "weightByHeld": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "eclipsedEliteChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sanctum": {
          "type": "object",
          "properties": {
            "chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["chance"],
          "additionalProperties": false
        }
      },
      "required": ["actBoss", "weightByHeld"],
      "additionalProperties": false
    },
    "priceCatalog": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/priceEntry"
      }
    },
    "costPools": {
      "type": "object",
      "patternProperties": {
        "^\\d+$": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/costEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "blessings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 1
          },
          "earned": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "boons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "type": "object"
                }
              },
              "required": ["type", "params"],
              "additionalProperties": false
            }
          },
          "costs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/costEntry"
            }
          },
          "pact": {
            "oneOf": [
              {
                "$ref": "#/$defs/costEntry"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lore": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/priceOption"
            }
          },
          "intrinsicPrice": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["label", "points"],
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/earnedSource"
            }
          },
          "twist": {
            "$ref": "#/$defs/costEntry"
          },
          "requires": {
            "type": "object",
            "properties": {
              "eclipse": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["id", "name", "description", "weight", "boons", "costs"],
        "additionalProperties": false,
        "if": {
          "properties": {
            "earned": {
              "const": true
            }
          },
          "required": ["earned"]
        },
        "then": {
          "required": ["sources"],
          "not": {
            "anyOf": [
              { "required": ["tier"] },
              { "required": ["prices"] },
              { "required": ["pact"] },
              { "required": ["intrinsicPrice"] }
            ]
          }
        },
        "else": {
          "required": ["tier"],
          "not": {
            "anyOf": [
              { "required": ["sources"] },
              { "required": ["twist"] },
              { "required": ["requires"] }
            ]
          }
        }
      }
    },
    "gifts": {
      "type": "object",
      "properties": {
        "offer": {
          "type": "object",
          "properties": {
            "fromRunsStarted": {
              "type": "integer",
              "minimum": 0
            },
            "chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["fromRunsStarted", "chance"],
          "additionalProperties": false
        },
        "list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gift"
          }
        }
      },
      "required": ["offer", "list"],
      "additionalProperties": false
    }
  },
  "required": ["version", "blessings", "costPools"],
  "additionalProperties": false,
  "$defs": {
    "effectEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "required": ["type", "params"],
      "additionalProperties": false
    },
    "costEntry": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effectEntry"
          }
        }
      },
      "required": ["label", "effects"],
      "additionalProperties": false
    },
    "priceEntry": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effectEntry"
          }
        }
      },
      "required": ["label", "points", "effects"],
      "additionalProperties": false
    },
    "priceOption": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "earnedSource": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["act_boss", "eclipsed_elite", "sanctum", "colosseum", "event"]
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "gift": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "lore": {
          "type": "string",
          "minLength": 1,
          "maxLength": 85
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "replaces": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "object",
          "properties": {
            "eclipse": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "grant": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["blessing", "accessories", "scrolls", "weapon", "whetstones"]
            }
          },
          "required": ["kind"]
        },
        "catch": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "prices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "effects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/effectEntry"
              }
            }
          },
          "required": ["label"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "description", "lore", "icon", "weight", "grant", "catch"],
      "additionalProperties": false
    }
  }
}
