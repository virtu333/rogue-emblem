{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recruits",
  "type": "object",
  "properties": {
    "namePool": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "act1": { "$ref": "#/$defs/actConfig" },
    "act2": { "$ref": "#/$defs/actConfig" },
    "act3": { "$ref": "#/$defs/actConfig" },
    "act4": { "$ref": "#/$defs/actConfig" }
  },
  "required": ["namePool", "act1", "act2", "act3", "act4"],
  "additionalProperties": false,
  "$defs": {
    "actConfig": {
      "type": "object",
      "properties": {
        "levelRange": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "classPool": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["levelRange", "classPool"],
      "additionalProperties": false
    }
  }
}
