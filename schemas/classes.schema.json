{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Classes",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/$defs/baseClass" },
      { "$ref": "#/$defs/promotedClass" },
      { "$ref": "#/$defs/bossClass" }
    ]
  },
  "$defs": {
    "statBlock": {
      "type": "object",
      "properties": {
        "HP": { "type": "integer" },
        "STR": { "type": "integer" },
        "MAG": { "type": "integer" },
        "SKL": { "type": "integer" },
        "SPD": { "type": "integer" },
        "DEF": { "type": "integer" },
        "RES": { "type": "integer" },
        "LCK": { "type": "integer" },
        "MOV": { "type": "integer" }
      },
      "required": ["HP", "STR", "MAG", "SKL", "SPD", "DEF", "RES", "LCK", "MOV"],
      "additionalProperties": false
    },
    "growthRanges": {
      "type": "object",
      "properties": {
        "HP": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "STR": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "MAG": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "SKL": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "SPD": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "DEF": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "RES": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "LCK": { "type": "string", "pattern": "^\\d+-\\d+$" }
      },
      "required": ["HP", "STR", "MAG", "SKL", "SPD", "DEF", "RES", "LCK"],
      "additionalProperties": false
    },
    "partialStatBlock": {
      "type": "object",
      "properties": {
        "HP": { "type": "integer" },
        "STR": { "type": "integer" },
        "MAG": { "type": "integer" },
        "SKL": { "type": "integer" },
        "SPD": { "type": "integer" },
        "DEF": { "type": "integer" },
        "RES": { "type": "integer" },
        "LCK": { "type": "integer" },
        "MOV": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "learnableSkill": {
      "type": "object",
      "properties": {
        "skillId": { "type": "string" },
        "level": { "type": "integer" }
      },
      "required": ["skillId", "level"],
      "additionalProperties": false
    },
    "masteryPerk": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 16 },
        "mods": {
          "type": "object",
          "properties": {
            "critBonus": { "type": "integer" },
            "hitBonus": { "type": "integer" },
            "avoidBonus": { "type": "integer" },
            "atkBonus": { "type": "integer" },
            "defBonus": { "type": "integer" },
            "resBonus": { "type": "integer" },
            "spdBonus": { "type": "integer" }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": ["name", "mods"],
      "additionalProperties": false
    },
    "moveType": {
      "type": "string",
      "enum": ["Infantry", "Cavalry", "Flying", "Armored"]
    },
    "baseClass": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tier": { "type": "string", "const": "base" },
        "description": { "type": "string" },
        "lore": { "type": "string", "minLength": 1 },
        "baseStats": { "$ref": "#/$defs/statBlock" },
        "moveType": { "$ref": "#/$defs/moveType" },
        "weaponProficiencies": { "type": "string" },
        "role": { "type": "string" },
        "descentOnly": {
          "type": "boolean",
          "description": "Act V's alone (engine/DescentSwitch.js): Help and the Compendium leave it out while the Descent is off."
        },
        "noEnemySkills": {
          "type": "boolean",
          "description": "An enemy of this class never learns a skill (no innate, no rolled combat skill): the Hollowed."
        },
        "growthRanges": { "$ref": "#/$defs/growthRanges" },
        "masteryPerk": { "$ref": "#/$defs/masteryPerk" },
        "promotesTo": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "learnableSkills": {
          "type": "array",
          "items": { "$ref": "#/$defs/learnableSkill" }
        }
      },
      "required": [
        "name",
        "tier",
        "baseStats",
        "moveType",
        "weaponProficiencies",
        "role",
        "growthRanges",
        "promotesTo"
      ],
      "additionalProperties": false
    },
    "promotedClass": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tier": { "type": "string", "const": "promoted" },
        "description": { "type": "string" },
        "lore": { "type": "string", "minLength": 1 },
        "promotesFrom": { "type": "string" },
        "promotionBonuses": { "$ref": "#/$defs/statBlock" },
        "moveType": { "$ref": "#/$defs/moveType" },
        "weaponProficiencies": { "type": "string" },
        "enemyWeapon": {
          "type": "string",
          "description": "An enemy-only weapon (weapons.json, price 0, in no loot table) this class carries in place of the tier pick."
        },
        "descentOnly": {
          "type": "boolean",
          "description": "Act V's alone (engine/DescentSwitch.js): Help and the Compendium leave it out while the Descent is off."
        },
        "roleChange": {
          "type": "string",
          "description": "The promotion path's note after its weapons. Never name a weapon: the chooser builds 'Gains Axes' (or 'Staves: Master' for a weapon the unit already uses) from weaponProficiencies."
        },
        "growthBonuses": { "$ref": "#/$defs/partialStatBlock" },
        "learnableSkills": {
          "type": "array",
          "items": { "$ref": "#/$defs/learnableSkill" }
        }
      },
      "required": [
        "name",
        "tier",
        "promotesFrom",
        "promotionBonuses",
        "moveType",
        "weaponProficiencies"
      ],
      "additionalProperties": false
    },
    "bossClass": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tier": { "type": "string", "const": "boss" },
        "description": { "type": "string" },
        "lore": { "type": "string", "minLength": 1 },
        "baseStats": { "$ref": "#/$defs/statBlock" },
        "moveType": { "$ref": "#/$defs/moveType" },
        "weaponProficiencies": { "type": "string" },
        "role": { "type": "string" },
        "enemyWeapon": {
          "type": "string",
          "description": "The enemy-only weapon this boss-tier class wields (the Grasping Limb's Grasping Coil: weapons.json, price 0, in no loot table)."
        },
        "statsByAct": {
          "type": "object",
          "description": "A boss-tier class's stats in a later act (the Iron Guardian): the act's own block, else the nearest earlier one listed, else baseStats. Its level is then the spawn's (XP reads it).",
          "propertyNames": { "enum": ["act2", "act3", "act4", "finalBoss"] },
          "additionalProperties": { "$ref": "#/$defs/statBlock" }
        },
        "footprint": {
          "type": "object",
          "description": "A big body (EntitySystem.footprintSize; docs/specs/large-units.md): the tiles it fills from its top-left tile. The Entity's 3x3 is a constant, never this.",
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 3 },
            "height": { "type": "integer", "minimum": 1, "maximum": 3 }
          },
          "required": ["width", "height"],
          "additionalProperties": false
        },
        "plates": {
          "type": "object",
          "description": "Iron Plates (engine/IronGuardian.js): a plate shed for each equal share of max HP lost, each one DEF down and STR up.",
          "properties": {
            "count": { "type": "integer", "minimum": 2, "maximum": 8 },
            "defPerPlate": { "type": "integer", "minimum": 0, "maximum": 10 },
            "strPerPlate": { "type": "integer", "minimum": 0, "maximum": 10 }
          },
          "required": ["count", "defPerPlate", "strPerPlate"],
          "additionalProperties": false
        },
        "hammerfall": {
          "type": "object",
          "description": "Hammerfall (engine/IronGuardian.js): the might of the telegraphed slam.",
          "properties": { "might": { "type": "integer", "minimum": 0, "maximum": 30 } },
          "required": ["might"],
          "additionalProperties": false
        }
      },
      "required": ["name", "tier", "baseStats", "moveType", "weaponProficiencies", "role"],
      "additionalProperties": false
    }
  }
}
