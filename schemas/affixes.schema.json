{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Affixes",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "affixes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tier": { "type": "integer", "minimum": 1 },
          "trigger": {
            "type": "string",
            "enum": [
              "passive",
              "passive-aura",
              "on-attack",
              "on-defend",
              "on-turn-start",
              "on-death"
            ]
          },
          "range": { "type": "integer", "minimum": 1 },
          "condition": { "type": "string" },
          "effects": { "type": "object" },
          "weight": { "type": "number", "minimum": 0 },
          "icon": { "type": "string", "minLength": 1 },
          "narrativeHint": { "type": "string" },
          "aiOverride": { "type": "string" }
        },
        "required": ["id", "name", "description", "tier", "trigger", "effects", "weight", "icon"],
        "additionalProperties": false
      }
    },
    "config": { "type": "object" }
  },
  "required": ["version", "affixes", "config"],
  "additionalProperties": false
}
