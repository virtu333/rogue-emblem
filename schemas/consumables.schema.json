{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consumables",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "const": "Consumable" },
      "effect": {
        "type": "string",
        "enum": ["heal", "healFull", "promote", "statBoost", "reclass", "cure", "cureHeal"]
      },
      "subEffect": { "type": "string" },
      "stat": {
        "type": "string",
        "enum": ["HP", "STR", "MAG", "SKL", "SPD", "DEF", "RES", "LCK", "MOV"]
      },
      "value": { "type": "integer" },
      "uses": { "type": "integer", "minimum": 1 },
      "price": { "type": "integer", "minimum": 0 }
    },
    "required": ["name", "type", "effect", "value", "uses", "price"],
    "additionalProperties": false
  }
}
