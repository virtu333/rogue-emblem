{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enemies",
  "type": "object",
  "properties": {
    "pools": {
      "type": "object",
      "patternProperties": {
        "^(act[1-4]|postAct|finalBoss)$": {
          "type": "object",
          "properties": {
            "levelRange": {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 2,
              "maxItems": 2
            },
            "base": { "type": "array", "items": { "type": "string" } },
            "promoted": { "type": "array", "items": { "type": "string" } },
            "sunderChance": { "type": "number", "minimum": 0, "maximum": 1 },
            "poisonChance": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["levelRange", "base", "promoted"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bosses": {
      "type": "object",
      "patternProperties": {
        "^(act[1-4]|finalBoss)$": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "className": { "type": "string" },
              "level": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "difficultyFilter": {
                "type": "array",
                "items": { "type": "string", "enum": ["normal", "dusk", "hard", "lunatic"] }
              },
              "isEntity": { "type": "boolean" },
              "epithet": { "type": "string", "minLength": 1, "maxLength": 36 },
              "lore": { "type": "string", "minLength": 1 }
            },
            "required": ["className", "level", "name"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "elites": {
      "type": "object",
      "patternProperties": {
        "^(act[1-4]|postAct)$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "className": { "type": "string" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["className", "name"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "eliteAreaArts": {
      "description": "Area weapon arts some enemies carry on elite battles (EnemyAreaArts.js).",
      "type": "object",
      "properties": {
        "minDifficulty": { "type": "string", "minLength": 1 },
        "acts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(act[1-4]|postAct|finalBoss)$" }
        },
        "count": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "byWeaponType": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["minDifficulty", "acts", "count", "byWeaponType"],
      "additionalProperties": false
    },
    "enemyCountByTiles": {
      "type": "object",
      "patternProperties": {
        "^\\d+$": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["pools", "bosses", "enemyCountByTiles"],
  "additionalProperties": false
}
