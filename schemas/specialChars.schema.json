        "required": [
          "normal",
          "dusk",
          "hard",
          "lunatic"
        ],
        "additionalProperties": false
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "weapons": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
