{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Special Characters",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "class": {
        "type": "string",
        "minLength": 1
      },
      "baseClass": {
        "type": "string",
        "minLength": 1
      },
      "temperament": {
        "type": "string",
        "minLength": 1
      },
      "bio": {
        "type": "string",
        "minLength": 1
      },
      "baseStats": {
        "type": "object",
        "properties": {
          "HP": {
            "type": "integer",
            "minimum": 0
          },
          "STR": {
            "type": "integer",
            "minimum": 0
          },
          "MAG": {
            "type": "integer",
            "minimum": 0
          },
          "SKL": {
            "type": "integer",
            "minimum": 0
          },
          "SPD": {
            "type": "integer",
            "minimum": 0
          },
          "DEF": {
            "type": "integer",
            "minimum": 0
          },
          "RES": {
            "type": "integer",
            "minimum": 0
          },
          "LCK": {
            "type": "integer",
            "minimum": 0
          },
          "MOV": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "HP",
          "STR",
          "MAG",
          "SKL",
          "SPD",
          "DEF",
          "RES",
          "LCK",
          "MOV"
        ],
        "additionalProperties": false
      },
      "growths": {
        "type": "object",
        "properties": {
          "HP": {
            "type": "integer",
            "minimum": 0
          },
          "STR": {
            "type": "integer",
            "minimum": 0
          },
          "MAG": {
            "type": "integer",
            "minimum": 0
          },
          "SKL": {
            "type": "integer",
            "minimum": 0
          },
          "SPD": {
            "type": "integer",
            "minimum": 0
          },
          "DEF": {
            "type": "integer",
            "minimum": 0
          },
          "RES": {
            "type": "integer",
            "minimum": 0
          },
          "LCK": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "HP",
          "STR",
          "MAG",
          "SKL",
          "SPD",
          "DEF",
          "RES",
          "LCK"
        ],
        "additionalProperties": false
      },
      "difficultyBases": {
        "type": "object",
        "properties": {
          "normal": {
            "type": "object",
            "properties": {
              "HP": {
                "type": "integer",
                "minimum": 0
              },
              "DEF": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "HP",
              "DEF"
            ],
            "additionalProperties": false
          },
          "dusk": {
            "type": "object",
            "properties": {
              "HP": {
                "type": "integer",
                "minimum": 0
              },
              "DEF": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "HP",
              "DEF"
            ],
            "additionalProperties": false
          },
          "hard": {
            "type": "object",
            "properties": {
              "HP": {
                "type": "integer",
                "minimum": 0
              },
              "DEF": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "HP",
              "DEF"
            ],
            "additionalProperties": false
          },
          "lunatic": {
            "type": "object",
            "properties": {
