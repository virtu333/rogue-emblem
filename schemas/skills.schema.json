{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "trigger": {
        "type": "string",
        "enum": [
          "passive",
          "passive-aura",
          "on-combat-start",
          "on-attack",
          "on-turn-start",
          "on-defend",
          "on-kill",
          "action"
        ]
      },
      "activation": {
        "type": "string"
      },
      "condition": {
        "type": "string",
        "enum": [
          "initiating",
          "defending",
          "adjacent_ally",
          "no_adjacent_ally",
          "above50_defending",
          "moved_3_plus_initiating",
          "below50",
          "below25"
        ]
      },
      "range": {
        "type": "integer"
      },
      "rangeMin": {
        "type": "integer"
      },
      "auraTarget": {
        "type": "string"
      },
      "effects": {
        "type": "object"
      },
      "actionAbility": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "teleport_self",
              "ally_buff",
              "aoe_heal",
              "aoe_root",
              "push_enemy",
              "transfer_hp",
              "sacrifice_heal",
              "refresh_adjacent",
              "warp_strike",
              "steal_item"
            ]
          },
          "range": {
            "type": "integer",
            "minimum": 1
          },
          "radius": {
            "type": "integer",
            "minimum": 1
          },
          "stats": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "durationPhases": {
            "type": "integer",
            "minimum": 1
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "includeSelf": {
            "type": "boolean"
          },
          "distance": {
            "type": "integer",
            "minimum": 1
          },
          "perMapLimit": {
            "type": "integer",
            "minimum": 1
          },
          "usableWhileSilenced": {
            "type": "boolean"
          }
        },
        "required": ["kind"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "teleport_self",
                    "ally_buff",
                    "aoe_heal",
                    "aoe_root",
                    "sacrifice_heal",
                    "refresh_adjacent",
                    "warp_strike"
                  ]
                }
              }
            },
            "then": {
              "required": ["perMapLimit"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "push_enemy"
                }
              }
            },
            "then": {
              "required": ["distance"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "transfer_hp"
                }
              }
            },
            "then": {
              "required": ["amount"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "sacrifice_heal"
                }
              }
            },
            "then": {
              "required": ["amount", "radius"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "warp_strike"
                }
              }
            },
            "then": {
              "required": ["range"]
            }
          }
        ]
      },
      "personal": {
        "type": "boolean"
      },
      "classInnate": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "cantoRule": {
        "enum": ["any", "noncombat"]
      }
    },
    "required": ["id", "name", "description", "trigger"],
    "additionalProperties": false
  }
}
