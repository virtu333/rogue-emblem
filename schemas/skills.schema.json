{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "trigger": {
        "type": "string",
        "enum": [
          "passive",
          "passive-aura",
          "on-combat-start",
          "on-attack",
          "on-turn-start",
          "on-defend",
          "action"
        ]
      },
      "activation": { "type": "string" },
      "condition": { "type": "string" },
      "range": { "type": "integer" },
      "rangeMin": { "type": "integer" },
      "auraTarget": { "type": "string" },
      "effects": { "type": "object" },
      "actionAbility": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["teleport_self", "ally_buff", "aoe_heal", "aoe_root"]
          },
          "range": { "type": "integer", "minimum": 1 },
          "radius": { "type": "integer", "minimum": 1 },
          "stats": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          },
          "durationPhases": { "type": "integer", "minimum": 1 },
          "amount": { "type": "integer", "minimum": 1 },
          "includeSelf": { "type": "boolean" },
          "perMapLimit": { "type": "integer", "minimum": 1 }
        },
        "required": ["kind", "perMapLimit"],
        "additionalProperties": false
      },
      "personal": { "type": "boolean" },
      "classInnate": {
        "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
      }
    },
    "required": ["id", "name", "description", "trigger"],
    "additionalProperties": false
  }
}
