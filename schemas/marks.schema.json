{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marks (recruit procs, docs/specs/phase3.md 3C)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "trigger": {
        "enum": ["weapon-art-cost", "on-attack", "on-kill", "on-defend", "on-turn-start"]
      },
      "chance": { "type": "integer", "minimum": 1, "maximum": 100 },
      "effect": {
        "type": "object",
        "properties": {
          "waiveArtHpCost": { "const": true },
          "damageBonus": { "type": "integer", "minimum": 1 },
          "healFlat": { "type": "integer", "minimum": 1 },
          "halveMagicDamage": { "const": true },
          "movBonus": { "type": "integer", "minimum": 1 }
        },
        "minProperties": 1,
        "additionalProperties": false
      }
    },
    "required": ["id", "name", "description", "trigger", "chance", "effect"],
    "additionalProperties": false
  }
}
