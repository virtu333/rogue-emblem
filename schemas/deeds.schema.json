{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deeds and Epithets",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "tuning": {
      "type": "object",
      "properties": {
        "heldPhaseMinAttacks": { "type": "integer", "minimum": 1 },
        "shieldPhaseMinAttacks": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "places": { "$ref": "#/$defs/phrases" },
    "weapons": { "$ref": "#/$defs/phrases" },
    "bosses": { "$ref": "#/$defs/phrases" },
    "deeds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/deed" }
    }
  },
  "required": ["version", "places", "weapons", "deeds"],
  "additionalProperties": false,
  "$defs": {
    "phrases": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 28 }
    },
    "condition": {
      "type": "object",
      "properties": {
        "type": { "enum": ["all", "battleStat", "runStat", "runStatMap", "runStatBest"] },
        "stat": { "type": "string", "minLength": 1 },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "tokens": { "type": "string", "minLength": 1 },
        "of": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1 }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "deed": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "scope": { "enum": ["battle", "run"] },
        "condition": { "$ref": "#/$defs/condition" },
        "epithet": {
          "type": "object",
          "properties": {
            "form": { "enum": ["who", "the", "of", "bane", "title", "name"] },
            "text": { "type": "string", "minLength": 1, "maxLength": 28 }
          },
          "required": ["form", "text"],
          "additionalProperties": false
        },
        "prestige": { "type": "integer", "minimum": 1, "maximum": 5 },
        "oathSkill": { "type": "string", "minLength": 1 },
        "oathName": { "type": "string", "minLength": 1, "maxLength": 32 },
        "lore": { "type": "string", "minLength": 1, "maxLength": 85 }
      },
      "required": ["id", "name", "scope", "condition", "epithet", "prestige", "lore"],
      "additionalProperties": false
    }
  }
}
