{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weapon Arts",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "mvp": {
      "type": "object",
      "properties": {
        "wave": { "type": "string" },
        "costModel": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["wave", "costModel", "notes"],
      "additionalProperties": false
    },
    "areaXp": {
      "type": "object",
      "properties": {
        "hitRate": { "type": "number", "minimum": 0 },
        "killRate": { "type": "number", "minimum": 0 },
        "actionBaseCap": { "type": "number", "minimum": 0 }
      },
      "required": ["hitRate", "killRate", "actionBaseCap"],
      "additionalProperties": false
    },
    "arts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "weaponType": {
            "type": "string",
            "enum": ["Sword", "Lance", "Axe", "Bow", "Tome", "Light", "Staff", "Breath"]
          },
          "tierAffinity": { "type": "string", "enum": ["Iron", "Steel", "Silver", "Legendary"] },
          "legacy": { "type": "boolean" },
          "noFollowUp": { "type": "boolean" },
          "spawnTiers": {
            "type": "array",
            "items": { "type": "string", "enum": ["Iron", "Steel", "Silver"] },
            "minItems": 1,
            "uniqueItems": true
          },
          "scrollOnly": { "type": "boolean" },
          "unlockAct": { "type": "string", "enum": ["act1", "act2", "act3", "act4", "finalBoss"] },
          "requiredRank": { "type": "string", "enum": ["Prof", "Mast"] },
          "hpCost": { "type": "integer", "minimum": 0 },
          "perTurnLimit": { "type": "integer", "minimum": 1 },
          "perMapLimit": { "type": "integer", "minimum": 1 },
          "targeting": { "type": "string", "enum": ["normal_attack", "chosen_center"] },
          "area": {
            "type": "object",
            "properties": {
              "shape": { "type": "string", "enum": ["radius", "line", "around_attacker"] },
              "radius": { "type": "integer", "minimum": 1 },
              "length": { "type": "integer", "minimum": 1 },
              "pick": { "type": "string", "enum": ["all", "lowest_hp_pct"] },
              "maxTargets": { "type": "integer", "minimum": 1 },
              "damage": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "scaled" },
                      "multiplier": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["kind", "multiplier"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "fixed" },
                      "amount": { "type": "integer", "minimum": 1 }
                    },
                    "required": ["kind", "amount"],
                    "additionalProperties": false
                  }
                ]
              },
              "strikes": { "type": "string", "enum": ["once", "each_landed"] },
              "nonLethal": { "type": "boolean" },
              "drainPercent": { "type": "number", "exclusiveMinimum": 0 },
              "centerRange": {
                "oneOf": [
                  { "const": "weapon" },
                  {
                    "type": "object",
                    "properties": {
                      "min": { "type": "integer", "minimum": 0 },
                      "max": { "type": "integer", "minimum": 1 }
                    },
                    "required": ["min", "max"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": ["shape", "damage"],
            "additionalProperties": false
          },
          "description": { "type": "string" },
          "combatMods": { "type": "object" },
          "effects": { "type": "object" },
          "allowedFactions": { "type": "array", "items": { "type": "string" } },
          "allowedTypes": { "type": "array", "items": { "type": "string" } },
          "legendaryWeaponIds": { "type": "array", "items": { "type": "string" } },
          "_deferredMechanic": { "type": "string" }
        },
        "required": [
          "id",
          "name",
          "weaponType",
          "tierAffinity",
          "unlockAct",
          "requiredRank",
          "hpCost",
          "perMapLimit",
          "targeting",
          "description",
          "combatMods"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "mvp", "arts"],
  "additionalProperties": false
}
