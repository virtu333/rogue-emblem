{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Events on the route map (docs/specs/event-nodes.md)",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "costScale": {
      "type": "object",
      "properties": {
        "normal": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dusk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hard": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lunatic": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["normal", "dusk", "hard", "lunatic"],
      "additionalProperties": false
    },
    "burdens": {
      "type": "object",
      "properties": {
        "ill_omen": {
          "$ref": "#/$defs/burden"
        },
        "debt": {
          "$ref": "#/$defs/burden"
        },
        "hunted": {
          "$ref": "#/$defs/burden"
        },
        "sworn_enemy": {
          "$ref": "#/$defs/burden"
        },
        "wounded": {
          "$ref": "#/$defs/burden"
        }
      },
      "required": ["ill_omen", "debt", "hunted", "sworn_enemy", "wounded"],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "required": ["version", "costScale", "burdens", "events"],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rungs": {
      "enum": ["normal", "dusk", "hard", "lunatic"]
    },
    "amount": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "base": {
              "type": "number"
            },
            "perAct": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "burden": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string"
        },
        "battles": {
          "type": "integer",
          "minimum": 1
        },
        "extraShadow": {
          "type": "integer",
          "minimum": 0
        },
        "garnish": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "value": {
          "type": "integer",
          "maximum": -1
        },
        "wave": {
          "type": "object",
          "properties": {
            "turn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "count": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            },
            "xpMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "onRung": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/rungs"
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "required": ["label"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["act1", "act2", "act3", "act4"]
          },
          "uniqueItems": true
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "oncePerRun": {
          "type": "boolean"
        },
        "fallback": {
          "type": "boolean"
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "pages": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/page"
          }
        },
        "dark": {
          "type": "object",
          "properties": {
            "intro": {
              "type": "string",
              "minLength": 1
            },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/choice"
              }
            },
            "pages": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "#/$defs/page"
              }
            }
          },
          "required": ["intro", "choices"],
          "additionalProperties": false
        },
        "counters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "countersByRung": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/rungs"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "counterLabels": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["id", "title", "weight", "intro", "choices"],
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "acts": {
          "type": "array",
          "items": {
            "enum": ["act1", "act2", "act3", "act4"]
          }
        },
        "minRow": {
          "type": "integer"
        },
        "maxRow": {
          "type": "integer"
        },
        "difficultyAtLeast": {
          "$ref": "#/$defs/rungs"
        },
        "difficultyAtMost": {
          "$ref": "#/$defs/rungs"
        },
        "phaseAtLeast": {
          "type": "string"
        },
        "phaseAtMost": {
          "type": "string"
        },
        "goldAtLeast": {
          "$ref": "#/$defs/amount"
        },
        "roster": {
          "type": "object",
          "properties": {
            "weaponTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "magic": {
              "type": "boolean"
            },
            "staff": {
              "type": "boolean"
            },
            "minUnits": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "fallen": {
          "type": "boolean"
        },
        "consumable": {
          "type": "string"
        },
        "flag": {
          "type": "string"
        },
        "notFlag": {
          "type": "string"
        },
        "notBurden": {
          "type": "string"
        },
        "notContract": {
          "type": "boolean"
        },
        "blessingTier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "counterAtLeast": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/id"
            },
            "n": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["key", "n"],
          "additionalProperties": false
        },
        "flagAct": {
          "anyOf": [
            {
              "enum": ["earlier", "current"]
            },
            {
              "enum": ["act1", "act2", "act3", "act4"]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "target": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "filter": {
              "type": "object"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": ["prompt"],
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "properties": {
            "gold": {
              "$ref": "#/$defs/amount"
            }
          },
          "required": ["gold"],
          "additionalProperties": false
        },
        "check": {
          "type": "object",
          "properties": {
            "stats": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "of": {
              "enum": ["target", "bestInArmy"]
            },
            "base": {
              "type": "number"
            },
            "perPoint": {
              "type": "number"
            },
            "against": {
              "type": "number"
            },
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "byRung": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/rungs"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": ["stats", "of", "base", "perPoint", "against"],
          "additionalProperties": false
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "tells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tell"
          }
        }
      },
      "required": ["id", "label", "outcomes"],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "weight": {
          "type": "number"
        },
        "weightByRung": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/rungs"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "fallbackText": {
          "type": "string"
        },
        "fallback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      },
      "required": ["id", "text", "effects"],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "gold",
            "item",
            "learnSkill",
            "fallenSkill",
            "hp",
            "shadow",
            "vision",
            "blessing",
            "burden",
            "flag",
            "layToRest",
            "consume",
            "stat",
            "battle",
            "counter",
            "join",
            "contract",
            "routeEdit",
            "forge",
            "wear",
            "mend"
          ]
        }
      },
      "required": ["type"]
    },
    "page": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      },
      "required": ["text", "choices"],
      "additionalProperties": false
    },
    "tell": {
      "type": "object",
      "properties": {
        "when": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string"
            },
            "classes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "weaponType": {
              "type": "string"
            },
            "trait": {
              "type": "string"
            },
            "skill": {
              "type": "string"
            }
          },
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false
        },
        "line": {
          "type": "string",
          "minLength": 1
        },
        "reveals": {
          "$ref": "#/$defs/id"
        },
        "tilts": {
          "const": "pass"
        }
      },
      "required": ["when", "line"],
      "additionalProperties": false
    }
  }
}
