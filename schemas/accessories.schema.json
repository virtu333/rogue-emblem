{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Accessories",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "const": "Accessory" },
      "effects": {
        "type": "object",
        "patternProperties": {
          "^(HP|STR|MAG|SKL|SPD|DEF|RES|LCK|MOV)$": { "type": "integer" }
        },
        "additionalProperties": false
      },
      "combatEffects": { "type": "object" },
      "turnStartEffects": { "type": "object" },
      "price": { "type": "integer", "minimum": 0 },
      "legendary": {
        "type": "boolean",
        "description": "A legendary accessory: it never rolls a bound skill."
      },
      "retired": {
        "type": "boolean",
        "description": "Taken out of the game: in no loot table (so never dropped, sold or granted), kept in the catalog so copies already owned keep working; the Compendium lists it only once a save has found one."
      },
      "lore": { "type": "string", "minLength": 1 }
    },
    "required": ["name", "type", "effects", "price"],
    "additionalProperties": false
  }
}
