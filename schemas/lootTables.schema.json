{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loot Tables",
  "type": "object",
  "properties": {
    "act1": {
      "$ref": "#/$defs/actLootTable"
    },
    "act2": {
      "$ref": "#/$defs/actLootTable"
    },
    "act3": {
      "$ref": "#/$defs/actLootTable"
    },
    "act4": {
      "$ref": "#/$defs/actLootTable"
    },
    "finalBoss": {
      "$ref": "#/$defs/actLootTable"
    },
    "bondRings": {
      "$ref": "#/$defs/bondRings"
    }
  },
  "required": ["act1", "act2", "act3", "act4", "finalBoss"],
  "additionalProperties": false,
  "$defs": {
    "bondRarityWeights": {
      "type": "object",
      "properties": {
        "C": { "type": "number", "minimum": 0 },
        "B": { "type": "number", "minimum": 0 },
        "A": { "type": "number", "minimum": 0 },
        "S": { "type": "number", "minimum": 0 }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "bondSkillPool": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "bondRings": {
      "description": "Bond Rings (docs/specs/phase3.md 3H): the roll behind the one 'Bond Ring' accessory. rarityByAct weights the rarity of a ring found or bought in an act; pools lists the bound skill ids each rarity may roll; priceByRarity is the ring's price (shop and sell value); neverBound lists skill ids a ring can never lend (ids not yet in skills.json stay barred); lentInnates lists the personal or class-innate skills the pools lend on purpose (a ring lends, it never teaches, so class locks do not apply).",
      "type": "object",
      "properties": {
        "rarityByAct": {
          "type": "object",
          "properties": {
            "act1": { "$ref": "#/$defs/bondRarityWeights" },
            "act2": { "$ref": "#/$defs/bondRarityWeights" },
            "act3": { "$ref": "#/$defs/bondRarityWeights" },
            "act4": { "$ref": "#/$defs/bondRarityWeights" }
          },
          "required": ["act1", "act2", "act3", "act4"],
          "additionalProperties": false
        },
        "pools": {
          "type": "object",
          "properties": {
            "C": { "$ref": "#/$defs/bondSkillPool" },
            "B": { "$ref": "#/$defs/bondSkillPool" },
            "A": { "$ref": "#/$defs/bondSkillPool" },
            "S": { "$ref": "#/$defs/bondSkillPool" }
          },
          "required": ["C", "B", "A", "S"],
          "additionalProperties": false
        },
        "priceByRarity": {
          "type": "object",
          "properties": {
            "C": { "type": "integer", "minimum": 1 },
            "B": { "type": "integer", "minimum": 1 },
            "A": { "type": "integer", "minimum": 1 },
            "S": { "type": "integer", "minimum": 1 }
          },
          "required": ["C", "B", "A", "S"],
          "additionalProperties": false
        },
        "neverBound": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "lentInnates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["rarityByAct", "pools", "priceByRarity", "neverBound", "lentInnates"],
      "additionalProperties": false
    },
    "nameArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "weapon": {
          "type": "number",
          "minimum": 0
        },
        "healing": {
          "type": "number",
          "minimum": 0
        },
        "statBooster": {
          "type": "number",
          "minimum": 0
        },
        "promotion": {
          "type": "number",
          "minimum": 0
        },
        "skillScroll": {
          "type": "number",
          "minimum": 0
        },
        "weaponArtScroll": {
          "type": "number",
          "minimum": 0
        },
        "legendaryWeapon": {
          "type": "number",
          "minimum": 0
        },
        "accessory": {
          "type": "number",
          "minimum": 0
        },
        "forge": {
          "type": "number",
          "minimum": 0
        },
        "gold": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["gold"],
      "additionalProperties": false
    },
    "actLootTable": {
      "type": "object",
      "properties": {
        "weapons": {
          "$ref": "#/$defs/nameArray"
        },
        "healing": {
          "$ref": "#/$defs/nameArray"
        },
        "statBooster": {
          "$ref": "#/$defs/nameArray"
        },
        "promotion": {
          "$ref": "#/$defs/nameArray"
        },
        "skillScroll": {
          "$ref": "#/$defs/nameArray"
        },
        "weaponArtScroll": {
          "$ref": "#/$defs/nameArray"
        },
        "artTiers": {
          "description": "Iron/Steel weapon arts in this act: innateChance is the chance an Iron or Steel weapon from loot or a shop carries a random art without Iron/Steel Arms; scrollSlots is how many distinct scrolls of that tier each shop or loot roll draws (scrolls listed in weaponArtScroll are not drawn again).",
          "type": "object",
          "properties": {
            "innateChance": {
              "type": "object",
              "properties": {
                "Iron": { "type": "number", "minimum": 0, "maximum": 1 },
                "Steel": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "scrollSlots": {
              "type": "object",
              "properties": {
                "Iron": { "type": "integer", "minimum": 0 },
                "Steel": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "legendaryWeapon": {
          "$ref": "#/$defs/nameArray"
        },
        "accessories": {
          "$ref": "#/$defs/nameArray"
        },
        "forge": {
          "$ref": "#/$defs/nameArray"
        },
        "weights": {
          "$ref": "#/$defs/weights"
        },
        "goldRange": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bossRewards": {
          "$ref": "#/$defs/actLootTable"
        }
      },
      "required": [
        "weapons",
        "healing",
        "statBooster",
        "promotion",
        "skillScroll",
        "weaponArtScroll",
        "legendaryWeapon",
        "accessories",
        "forge",
        "weights",
        "goldRange"
      ],
      "additionalProperties": false
    }
  }
}
