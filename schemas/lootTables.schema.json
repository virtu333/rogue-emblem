{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loot Tables",
  "type": "object",
  "properties": {
    "act1": {
      "$ref": "#/$defs/actLootTable"
    },
    "act2": {
      "$ref": "#/$defs/actLootTable"
    },
    "act3": {
      "$ref": "#/$defs/actLootTable"
    },
    "act4": {
      "$ref": "#/$defs/actLootTable"
    },
    "finalBoss": {
      "$ref": "#/$defs/actLootTable"
    },
    "accessorySkills": {
      "$ref": "#/$defs/accessorySkills"
    }
  },
  "required": ["act1", "act2", "act3", "act4", "finalBoss"],
  "additionalProperties": false,
  "$defs": {
    "accessorySkillPool": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "accessorySkills": {
      "description": "Accessory skills (docs/specs/phase3.md 3H): any non-legendary accessory created from loot, a shop or an event grant may roll a bound skill. chanceByAct is the chance per accessory; poolByAct the skill ids an act may bind; priceMultiplier scales the price of an accessory that carries one; neverBound lists skill ids that can never be lent (ids not yet in skills.json stay barred); lentInnates lists the personal or class-innate skills the pools lend on purpose (a lent skill is never taught, so class locks do not apply).",
      "type": "object",
      "properties": {
        "chanceByAct": {
          "type": "object",
          "properties": {
            "act1": { "type": "number", "minimum": 0, "maximum": 1 },
            "act2": { "type": "number", "minimum": 0, "maximum": 1 },
            "act3": { "type": "number", "minimum": 0, "maximum": 1 },
            "act4": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["act1", "act2", "act3", "act4"],
          "additionalProperties": false
        },
        "poolByAct": {
          "type": "object",
          "properties": {
            "act1": { "$ref": "#/$defs/accessorySkillPool" },
            "act2": { "$ref": "#/$defs/accessorySkillPool" },
            "act3": { "$ref": "#/$defs/accessorySkillPool" },
            "act4": { "$ref": "#/$defs/accessorySkillPool" }
          },
          "required": ["act1", "act2", "act3", "act4"],
          "additionalProperties": false
        },
        "priceMultiplier": { "type": "number", "minimum": 1 },
        "neverBound": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "lentInnates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["chanceByAct", "poolByAct", "priceMultiplier", "neverBound", "lentInnates"],
      "additionalProperties": false
    },
    "nameArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "weapon": {
          "type": "number",
          "minimum": 0
        },
        "healing": {
          "type": "number",
          "minimum": 0
        },
        "statBooster": {
          "type": "number",
          "minimum": 0
        },
        "promotion": {
          "type": "number",
          "minimum": 0
        },
        "skillScroll": {
          "type": "number",
          "minimum": 0
        },
        "weaponArtScroll": {
          "type": "number",
          "minimum": 0
        },
        "legendaryWeapon": {
          "type": "number",
          "minimum": 0
        },
        "accessory": {
          "type": "number",
          "minimum": 0
        },
        "forge": {
          "type": "number",
          "minimum": 0
        },
        "gold": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["gold"],
      "additionalProperties": false
    },
    "actLootTable": {
      "type": "object",
      "properties": {
        "weapons": {
          "$ref": "#/$defs/nameArray"
        },
        "healing": {
          "$ref": "#/$defs/nameArray"
        },
        "statBooster": {
          "$ref": "#/$defs/nameArray"
        },
        "promotion": {
          "$ref": "#/$defs/nameArray"
        },
        "skillScroll": {
          "$ref": "#/$defs/nameArray"
        },
        "weaponArtScroll": {
          "$ref": "#/$defs/nameArray"
        },
        "artTiers": {
          "description": "Iron/Steel weapon arts in this act: innateChance is the chance an Iron or Steel weapon from loot or a shop carries a random art without Iron/Steel Arms; scrollSlots is how many distinct scrolls of that tier each shop or loot roll draws (scrolls listed in weaponArtScroll are not drawn again).",
          "type": "object",
          "properties": {
            "innateChance": {
              "type": "object",
              "properties": {
                "Iron": { "type": "number", "minimum": 0, "maximum": 1 },
                "Steel": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "scrollSlots": {
              "type": "object",
              "properties": {
                "Iron": { "type": "integer", "minimum": 0 },
                "Steel": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "legendaryWeapon": {
          "$ref": "#/$defs/nameArray"
        },
        "accessories": {
          "$ref": "#/$defs/nameArray"
        },
        "forge": {
          "$ref": "#/$defs/nameArray"
        },
        "weights": {
          "$ref": "#/$defs/weights"
        },
        "goldRange": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bossRewards": {
          "$ref": "#/$defs/actLootTable"
        }
      },
      "required": [
        "weapons",
        "healing",
        "statBooster",
        "promotion",
        "skillScroll",
        "weaponArtScroll",
        "legendaryWeapon",
        "accessories",
        "forge",
        "weights",
        "goldRange"
      ],
      "additionalProperties": false
    }
  }
}
